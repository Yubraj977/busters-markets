NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# URL where busters-daily (the deli TV display app) is running
# Defaults to http://localhost:3000 in development
DAILY_MENU_URL=http://localhost:3000

# Secret admin password for /bm-admin
ADMIN_PASSWORD=your_admin_password_here

# Backoffice/POS inventory API — base URL and shared static API key
BACKOFFICE_API_URL=https://your-backoffice-url
STOREFRONT_API_KEY=your_storefront_api_key_here
