NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# URL where busters-daily (the deli TV display app) is running
# Defaults to http://localhost:3000 in development
DAILY_MENU_URL=http://localhost:3000

# Secret admin password for /bm-admin
ADMIN_PASSWORD=your_admin_password_here

# Backoffice/POS inventory API — base URL and shared static API key
BACKOFFICE_API_URL=https://your-backoffice-url
STOREFRONT_API_KEY=your_storefront_api_key_here

# Clover Ecommerce API — a separate "Ecommerce" app in the Clover Developer
# Dashboard, distinct from whatever app the backoffice uses for inventory sync.
# NEXT_PUBLIC_CLOVER_APP_ID is the public App ID used client-side to tokenize
# cards; NEXT_PUBLIC_CLOVER_MERCHANT_ID is your Clover merchant id (also
# public, required by Clover.js to initialize); CLOVER_PRIVATE_TOKEN is the
# private token used server-side to charge a tokenized card. Never put the
# private token in client-exposed code.
NEXT_PUBLIC_CLOVER_APP_ID=your_clover_public_app_id
NEXT_PUBLIC_CLOVER_MERCHANT_ID=your_clover_merchant_id
NEXT_PUBLIC_CLOVER_ENV=sandbox
CLOVER_PRIVATE_TOKEN=your_clover_private_ecommerce_token
CLOVER_ENV=sandbox

# Dev-only: bypass the real Clover charge (server) and real card tokenization
# (client) so checkout can be built/tested before Clover credentials exist.
# Never set either of these in production.
MOCK_CHECKOUT_CHARGE=false
NEXT_PUBLIC_MOCK_CHECKOUT_CHARGE=false
